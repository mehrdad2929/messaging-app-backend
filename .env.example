# Database
DATABASE_URL="postgresql://mehrdad@localhost:5432/messaging_app_db?schema=public"

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Email verification (OTP)
# Pepper mixed into code hashes: a stolen DB backup alone can't recover live
# codes. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=your-random-32-byte-hex-here
# Outgoing mail. Leave unset in dev: codes print to the console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Messaging App <no-reply@example.com>"
# DEV ONLY: return the raw code in the request-code response so curl tests
# need no inbox. NEVER enable in production (it defeats the whole scheme).
# DEV_RETURN_CODE=true
