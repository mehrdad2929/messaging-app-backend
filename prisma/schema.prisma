// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Provider {
    GOOGLE
    GITHUB
}

model User {
    id                        Int                       @id @default(autoincrement())
    username                  String                    @unique
    email                     String?                   @unique
    password                  String?
    displayName               String
    picture                   String?
    provider                  Provider?
    providerId                String?
    messages                  Message[]                 @relation("UserMessages")
    messagesDeletedBy         Message[]                 @relation("messagesDeletedBy")
    conversationDeletedBy     Conversation[]            @relation("conversationDeletedBy")
    conversationsParticipated ConversationParticipant[] @relation("conversationParticipantDeletedBy")
    messagesRead              MessageRead[]
    createdAt                 DateTime                  @default(now())
    updatedAt                 DateTime                  @updatedAt
    deletedAt                 DateTime?
    conversationParticipants  ConversationParticipant[]

    @@unique([provider, providerId])
}

//thenredit last .sql for iff constraint on deletedBy and deletedAt
//TODO:add message reply
model Message {
    id             Int           @id @default(autoincrement())
    content        String
    userId         Int
    user           User          @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)
    conversationId Int
    conversation   Conversation  @relation("ConversationMessage", fields: [conversationId], references: [id], onDelete: Cascade)
    createdAt      DateTime      @default(now())
    messageReads   MessageRead[]
    deletedAt      DateTime?
    deletedById    Int?
    deletedBy      User?         @relation("messagesDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

    //@@unique constraint for faster quering the message table
    @@index([conversationId, id])
}

model MessageRead {
    id        Int     @id @default(autoincrement())
    user      User    @relation(fields: [userId], references: [id])
    userId    Int
    message   Message @relation(fields: [messageId], references: [id])
    messageId Int

    @@unique([userId, messageId])
}

model Conversation {
    id                       Int                       @id @default(autoincrement())
    name                     String?
    messages                 Message[]                 @relation("ConversationMessage")
    conversationParticipants ConversationParticipant[]
    conversationType         ConversationType          @default(DM)
    dmKey                    String?                   @unique
    deletedAt                DateTime?
    deletedBy                User?                     @relation("conversationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
    deletedById              Int?
}

enum ConversationType {
    DM
    GROUPCHAT
    CHANNEL
}

enum Role {
    MEMBER
    ADMIN
    OWNER
}

model ConversationParticipant {
    id             Int          @id @default(autoincrement())
    user           User         @relation(fields: [userId], references: [id])
    userId         Int
    conversation   Conversation @relation(fields: [conversationId], references: [id])
    conversationId Int
    role           Role         @default(MEMBER)
    joinedAt       DateTime     @default(now())
    deletedAt      DateTime?

    deletedById Int?
    deletedBy   User? @relation("conversationParticipantDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

    @@unique([userId, conversationId])
}
